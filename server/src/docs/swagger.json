{
  "openapi": "3.0.0",
  "info": {
    "title": "Multi-Tenant SaaS Project Management API",
    "version": "1.0.0",
    "description": "Production-grade Multi-Tenant SaaS Project Management API with strict tenant isolation, RBAC, and PERN stack."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "tenantHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Organization-Id"
      }
    }
  },
  "security": [
    {
      "bearerAuth": [],
      "tenantHeader": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": { "description": "API & DB healthy" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register user and create organization",
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "User login",
        "responses": {
          "200": { "description": "Login successful" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Current authenticated user",
        "responses": {
          "200": { "description": "Profile data" }
        }
      }
    },
    "/api/organizations": {
      "get": {
        "summary": "List user organizations",
        "responses": { "200": { "description": "List of organizations" } }
      },
      "post": {
        "summary": "Create organization",
        "responses": { "201": { "description": "Organization created" } }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "List tenant projects",
        "responses": { "200": { "description": "Paginated projects" } }
      },
      "post": {
        "summary": "Create project in tenant",
        "responses": { "201": { "description": "Project created" } }
      }
    },
    "/api/tasks": {
      "get": {
        "summary": "List tenant tasks",
        "responses": { "200": { "description": "Paginated tasks" } }
      },
      "post": {
        "summary": "Create task in tenant",
        "responses": { "201": { "description": "Task created" } }
      }
    },
    "/api/dashboard/stats": {
      "get": {
        "summary": "Get tenant metrics",
        "responses": { "200": { "description": "Aggregated stats" } }
      }
    }
  }
}
